# Local-dev Google OAuth credentials.
#
# Copy this file to api/.env.dev and fill in values from your Google Cloud
# Console OAuth client. The real api/.env.dev is gitignored; this *.example
# template is committed.
#
# Setup:
#   1. console.cloud.google.com -> APIs & Services -> Credentials
#   2. Create OAuth client ID (Web application). Authorized redirect URI:
#        http://localhost:8080/auth/google/callback
#   3. Add your Gmail address to the OAuth consent screen's "Test users" list.
#   4. Paste the client ID and secret below, then restart the stack:
#        ./dev-up.sh --keep-data --no-build
#
# If this file is absent, the API still boots but the Google sign-in button
# will fail at Google with "Missing required parameter: client_id". Use the
# alice-cookie injection from dev-up.sh's final summary instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback
